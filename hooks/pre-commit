#!/bin/sh
# Block invisible Unicode from entering the repo.
#
# Python files are delegated to ruff (RUF001-003 confusables, PLE2502 bidirectional)
# when it is available, so repos already running ruff do not get two divergent sets
# of diagnostics for the same characters.
#
# Documentation gets the prose profile: docs legitimately contain emoji and other
# scripts, and the code profile would flag - and on fix, corrupt - a ZWJ emoji
# sequence in a README. Everything else gets the code profile.
#
# --fail-on report, not the default: bidi overrides and NBSP are report-only under
# prose, so a gate using the default exit status would let Trojan Source into a
# README. A gate asks "is anything invisible here", not "would clean change it".
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$staged" ] || exit 0

py_files=$(printf '%s\n' "$staged" | grep '\.py$' || true)
docs=$(printf '%s\n' "$staged" | grep -Ei '\.(md|markdown|mdx|rst|txt|adoc|tex)$' || true)
code=$(printf '%s\n' "$staged" | grep -v '\.py$' \
    | grep -Eiv '\.(md|markdown|mdx|rst|txt|adoc|tex)$' || true)

status=0
failed_profiles=""

raise_status() {
    if [ "$1" -gt "$status" ]; then
        status=$1
    fi
}

inspect() {
    profile=$1
    shift
    rc=0
    # shellcheck disable=SC2086
    text-hygiene inspect --profile "$profile" --fail-on report "$@" || rc=$?
    if [ "$rc" -eq 1 ]; then
        # Record the profile that found something, so the fix hint names the right
        # one per group. A single global profile would tell the user to run
        # --profile code over their markdown, which is the corruption above.
        case " $failed_profiles " in
            *" $profile "*) ;;
            *) failed_profiles="$failed_profiles $profile" ;;
        esac
    fi
    raise_status "$rc"
}

if [ -n "$code" ]; then
    # shellcheck disable=SC2086
    inspect code $code
fi

if [ -n "$docs" ]; then
    # shellcheck disable=SC2086
    inspect prose $docs
fi

if [ -n "$py_files" ] && command -v ruff >/dev/null 2>&1; then
    rc=0
    # shellcheck disable=SC2086
    ruff check --select RUF001,RUF002,RUF003,PLE2502 $py_files || rc=$?
    # ruff exits >=2 when it fails to run; keep that distinct from "found findings".
    if [ "$rc" -ge 2 ]; then
        rc=2
    fi
    raise_status "$rc"
elif [ -n "$py_files" ]; then
    # shellcheck disable=SC2086
    inspect code $py_files
fi

# Anything above 1 is a tool that failed to run - including 127, command not found.
if [ "$status" -ge 2 ]; then
    echo "pre-commit: text-hygiene or ruff failed to run (exit $status)" >&2
    exit "$status"
fi
if [ "$status" -ne 0 ]; then
    echo "pre-commit: invisible Unicode found. Fix with:" >&2
    for profile in $failed_profiles; do
        echo "  text-hygiene clean --in-place --profile $profile <file>" >&2
    done
    exit 1
fi
