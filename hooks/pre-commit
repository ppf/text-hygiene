#!/bin/sh
# Block invisible Unicode from entering the repo.
#
# Python files are delegated to ruff (RUF001-003 confusables, PLE2502 bidirectional)
# when it is available, so repos already running ruff do not get two divergent sets
# of diagnostics for the same characters.
#
# Documentation gets the prose profile: docs legitimately contain emoji and other
# scripts, and the code profile would flag - and on fix, corrupt - a ZWJ emoji
# sequence in a README. Everything else gets the code profile.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$staged" ] || exit 0

py_files=$(printf '%s\n' "$staged" | grep '\.py$' || true)
docs=$(printf '%s\n' "$staged" | grep -Ei '\.(md|markdown|rst|txt|adoc)$' || true)
code=$(printf '%s\n' "$staged" | grep -v '\.py$' | grep -Eiv '\.(md|markdown|rst|txt|adoc)$' || true)

status=0
fix_profile=code

# Exit 2 (tool failed) must never be masked by exit 1 (findings), in either order.
raise_status() {
    if [ "$1" -gt "$status" ]; then
        status=$1
    fi
}

inspect() {
    profile=$1
    shift
    rc=0
    # shellcheck disable=SC2086
    text-hygiene inspect --profile "$profile" "$@" || rc=$?
    raise_status "$rc"
}

if [ -n "$code" ]; then
    # shellcheck disable=SC2086
    inspect code $code
fi

if [ -n "$docs" ]; then
    before=$status
    # shellcheck disable=SC2086
    inspect prose $docs
    if [ "$status" -ne "$before" ]; then
        fix_profile=prose
    fi
fi

if [ -n "$py_files" ] && command -v ruff >/dev/null 2>&1; then
    rc=0
    # shellcheck disable=SC2086
    ruff check --select RUF001,RUF002,RUF003,PLE2502 $py_files || rc=$?
    # ruff exits >=2 when it fails to run; keep that distinct from "found findings".
    if [ "$rc" -ge 2 ]; then
        rc=2
    fi
    raise_status "$rc"
elif [ -n "$py_files" ]; then
    # shellcheck disable=SC2086
    inspect code $py_files
fi

if [ "$status" -eq 2 ]; then
    echo "pre-commit: text-hygiene or ruff failed to run" >&2
    exit 2
fi
if [ "$status" -ne 0 ]; then
    echo "pre-commit: invisible Unicode found. Fix with:" >&2
    echo "  text-hygiene clean --in-place --profile $fix_profile <file>" >&2
    exit 1
fi
